<?xml version='1.0' encoding='utf-8'?>
<odoo>
       <record id ="estate_property_type_action" model="ir.actions.act_window">
    <field name="name">estate.property.type</field>
    <field name="res_model">estate.property.type</field>
    <field name ="view_mode">tree,form</field>
    </record> 

  <record id="action_estate_property_offer_stat" model="ir.actions.act_window">
    <field name="name">Offres liées</field>
    <field name="res_model">estate.property.offer</field>
    <field name="view_mode">tree,form</field>
    <field name="domain">[('property_type_id', '=', active_id)]</field>
</record>
<record id="action_estate_property_offer_tree" model="ir.ui.view">
    <field name="name">estate.property.offer</field>
    <field name="model">estate.property.offer</field>
    <field name="arch" type="xml">
    <tree>
       <field name="price"  />
       <field name="partner_id"/>
       <field  name ="validity"/>
      <field  name ="date_deadline"/>
      
    </tree>
       
    </field>
    
</record>


   <record id="view_estate_property_type_form" model="ir.ui.view">
    <field name="name">estate.property.type.form</field>
    <field name="model">estate.property.type</field>
    <field name="arch" type="xml">
      <form string="Property Type">
      <header>
      
      
      </header>
       <sheet>
        <div class="oe_button_box" name="offer_count">
                    <button name="%(action_estate_property_offer_stat)s" 
                            string="Voir Offres" 
                            type="action" 
                      />
                </div>
                 <field name="offer_count" widget="statinfo"/>
     
                <group>
                    <field name="name"/>
                    <field  name="sequence" widget="handle"/>
                   
                </group>
                 
                <notebook>
                    <page string="Propriétés">
                        <!-- Affichage en ligne (liste) du champ One2many -->
                        <field name="property_ids">
                            <tree editable="bottom">
                              
                                <field name="name"/>
                                <field name="expected_price"/>
                                <field name="status"/>
                                  
                            </tree>
                        </field>
                    </page>
                </notebook>
            </sheet>
      </form>
    </field>
  </record>
</odoo>